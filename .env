VITE_FIREBASE_AUTH_DOMAIN=cybercardgame.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://cybercardgame-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=cybercardgame
VITE_FIREBASE_STORAGE_BUCKET=cybercardgame.firebasestorage.app

# Copy to .env for local development. .env is gitignored.
# These are not secrets — the Firebase web config is compiled into the
# client bundle and is readable on the deployed site. Keeping them out of
# the repository stops GitHub's secret scanner firing and keeps them out
# of git history. Real protection comes from database rules and from
# HTTP referrer restrictions on the API key. See SECURITY.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
